# LLM API Keys（至少配置一个）
NR_DEEPSEEK_API_KEY=sk-xxx
# NR_OPENAI_API_KEY=sk-xxx

# LLM Defaults（可选，默认使用 DeepSeek V4 Flash）
# NR_LLM_DEFAULT_MODEL=deepseek/deepseek-chat
# NR_LLM_EMBEDDING_MODEL=text-embedding-3-small

# ChromaDB（可选，默认 ./data/chroma）
# NR_CHROMA_PERSIST_DIR=./data/chroma

# App（可选）
# NR_DEBUG=false
# NR_LOG_LEVEL=INFO

# --- 以下为生产环境可选（SQLite 足够开发使用）---
# NR_DATABASE_URL=postgresql+asyncpg://needradar:password@localhost:5432/needradar
# NR_REDIS_URL=redis://localhost:6379/0
