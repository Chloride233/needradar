# LLM API Keys（至少配置一个）
NR_DEEPSEEK_API_KEY=sk-xxx
# NR_OPENAI_API_KEY=sk-xxx
# NR_ANTHROPIC_API_KEY=sk-xxx

# Database（默认 SQLite，生产环境用 PostgreSQL）
# NR_DATABASE_URL=postgresql+asyncpg://needradar:changeme@localhost:5432/needradar

# ChromaDB（可选，默认 ./data/chroma）
# NR_CHROMA_PERSIST_DIR=./data/chroma

# GitHub Token（可选，提升爬取速率）
# NR_GITHUB_TOKEN=ghp_xxx

# App（可选）
# NR_DEBUG=false
# NR_LOG_LEVEL=INFO

# Docker Compose PostgreSQL（可选，覆盖默认值）
# POSTGRES_DB=needradar
# POSTGRES_USER=needradar
# POSTGRES_PASSWORD=changeme
